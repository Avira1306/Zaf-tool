---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import { templates, library } from '../../data/site';
---
<Base title="FDD Excel Templates: EV to Equity Bridge, QoE, PVM, Net Debt" description="Financial due diligence templates in the ZAF Template Library: EV to equity bridge, net debt, EBITDA normalisation, price-volume-mix, AR and AP ageing, plus FDD checklists." crumbs={[{ name: 'FDD templates', href: '/fdd-templates' }]}>
  <section class="section" style="padding-top:1.5rem">
    <div class="wrap">
      <span class="eyebrow">ZAF Template Library</span>
      <h1>FDD templates, inserted from the ribbon</h1>
      <p class="lede">Formula-driven schedules for financial due diligence. Each page explains how the schedule works; inside ZAF Tools you insert it into your workbook with one click from Template Library.</p>
      <div class="cards c3" style="margin-top:2rem">
        {library.map((t) => <a class="card" href={`/fdd-templates/${t.slug}`}><div class="tag">{t.category}</div><h3>{t.name}</h3><p>{t.desc.split('. ')[0].replace(/.$/, '')}.</p></a>)}
      </div>
      <h2 style="margin-top:3rem">FDD guides and checklists</h2>
      <div class="cards c3" style="margin-top:1rem">
        {templates.map((t) => <a class="card" href={`/fdd-templates/${t.slug}`}><div class="tag">Guide</div><h3>{t.name}</h3><p>{t.what.split('. ')[0].replace(/.$/, '')}.</p></a>)}
      </div>
    </div>
  </section>
  <CTA title="Get the full library inside Excel" text="Start a 14-day free trial and insert any template from the ZAF AI ribbon, or let Run Full FDD build the schedules from your trial balance." />
</Base>
