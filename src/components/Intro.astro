---
// Launch-style homepage intro: three product panels on warm ink; on scroll the
// middle panel widens to full bleed and the headline rises over it.
// All copy is real HTML text; only the visuals animate.
const toc = [
  { n: '01', label: 'Workflow', href: '#workflow' },
  { n: '02', label: 'Hours saved', href: '#hours-saved' },
  { n: '03', label: 'Template library', href: '#library' },
  { n: '04', label: 'Pricing', href: '#pricing' },
];
---
<section class="intro" data-intro aria-labelledby="intro-title">
  <div class="intro-stage">
    <div class="intro-panels" aria-hidden="true">
      <div class="ip ip-side"><img src="/img/nwc-schedule.webp" alt="" width="1914" height="1135" loading="lazy" /></div>
      <div class="ip ip-mid">
        <img class="ip-shot" src="/img/pl-commentary.webp" alt="" width="1917" height="1130" fetchpriority="high" />
        <div class="ip-brand">
          <p class="intro-kicker">Introducing</p>
          <picture><source srcset="/img/zaf-logo.webp" type="image/webp" /><img src="/img/zaf-logo.png" alt="" width="261" height="96" fetchpriority="high" /></picture>
          <p class="ip-ver">FDD Suite 5.0</p>
          <p class="ip-tag">Trial balance in. FDD databook out.</p>
        </div>
      </div>
      <div class="ip ip-side"><img src="/img/ebitda-bridge.webp" alt="" width="1914" height="1132" loading="lazy" /></div>
    </div>

    <div class="intro-copy">
      <p class="intro-eyebrow">ZAF FDD Suite 5.0 · AI financial due diligence, inside Excel</p>
      <h1 id="intro-title">Trial balance in.<br /><span>FDD databook out.</span></h1>
      <p class="intro-lede">ZAF maps the TB, builds the statements, runs Quality of Earnings and the EBITDA bridge, and drafts partner-ready commentary. Everything stays in Excel and traces back to source.</p>
      <div class="intro-cta">
        <a class="btn intro-btn-primary" href="/start-trial?type=demo">Book a live demo</a>
        <a class="btn intro-btn-ghost" href="/start-trial">Request a trial</a>
      </div>
      <ol class="intro-toc">
        {toc.map((t) => <li><a href={t.href}><span>{t.n}</span>{t.label}</a></li>)}
      </ol>
    </div>
  </div>
</section>

<style>
  .intro {
    --bg: #1a1714; --fg: #f3eee4; --muted: #b9b0a1; --accent: #c9a227;
    --p: 0;               /* scroll progress 0..1, set by script */
    position: relative; height: 260vh; background: var(--bg); color: var(--fg);
  }
  .intro-stage { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }

  /* Panels: middle grows from 1/3 to full width, sides shrink and fade */
  .intro-panels {
    position: absolute; inset: calc(12vh * (1 - var(--p))) calc(4vw * (1 - var(--p)));
    display: flex; gap: calc(1.2vw * (1 - var(--p)));
  }
  .ip { overflow: hidden; border-radius: calc(6px * (1 - var(--p))); background: #2a2520; }
  .ip img { width: 100%; height: 100%; object-fit: cover; object-position: left top; }
  .ip-side { flex: calc(1 - var(--p)) 1 0; opacity: calc(1 - var(--p) * 1.4); }
  .ip-side img { filter: grayscale(.5) brightness(.55); }
  .ip-mid { flex: calc(1 + var(--p) * 8) 1 0; position: relative; background: #f3eee4; display: grid; place-items: center; }
  .ip-mid::after {           /* cream card turns to ink as it fills the screen */
    content: ''; position: absolute; inset: 0; background: var(--bg);
    opacity: clamp(0, calc((var(--p) - .25) * 3), .88);
  }
  .ip-shot { position: absolute; inset: 0; opacity: clamp(0, calc((var(--p) - .25) * 3), 1); }
  .ip-brand { position: relative; z-index: 1; }
  .ip-brand {
    text-align: center; width: min(80%, 360px);
    scale: calc(1 + var(--p) * .6); opacity: clamp(0, calc(1 - (var(--p) - .15) * 3), 1);
  }
  .ip-brand img { width: 100%; height: auto; object-fit: contain; animation: intro-in 1.1s .1s ease-out both; }
  .intro-kicker {
    margin: 0 0 1.2rem; color: #1a1714; font-size: clamp(1.1rem, 1.8vw, 1.5rem);
    font-weight: 500; letter-spacing: .02em; animation: intro-in 1.1s .4s ease-out both;
  }
  .ip-tag { margin: .9rem auto 0; color: #1a1714; font-size: clamp(1.05rem, 1.6vw, 1.35rem); font-weight: 700; letter-spacing: -.01em; line-height: 1.25; animation: intro-in 1.1s 1s ease-out both; }
  .ip-ver { margin: 1.2rem auto 0; color: #7a6a4a; font-size: .95rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; animation: intro-in 1.1s .7s ease-out both; }

  .intro-copy {
    position: absolute; inset: auto 0 0 0; padding: 0 max(1.25rem, calc((100% - 1120px) / 2)) clamp(2rem, 7vh, 4.5rem);
    opacity: clamp(0, calc((var(--p) - .35) * 3), 1);
    translate: 0 calc((1 - clamp(0, calc((var(--p) - .35) * 3), 1)) * 60px);
  }
  .intro-eyebrow { color: var(--accent); font-weight: 600; font-size: .92rem; letter-spacing: .02em; margin: 0 0 1rem; }
  .intro h1 { color: var(--fg); font-size: clamp(2.4rem, 6.2vw, 5rem); line-height: 1.02; letter-spacing: -.025em; margin: 0 0 1.1rem; font-weight: 700; }
  .intro h1 span { color: var(--accent); }
  .intro-lede { color: var(--muted); font-size: clamp(1rem, 1.4vw, 1.2rem); max-width: 60ch; }
  .intro-cta { display: flex; flex-wrap: wrap; gap: .75rem; margin: 1.5rem 0 2rem; }
  .intro-btn-primary { background: var(--accent); color: var(--bg); }
  .intro-btn-primary:hover { background: #dbb437; color: var(--bg); }
  .intro-btn-ghost { border-color: rgba(243,238,228,.35); color: var(--fg); background: transparent; }
  .intro-btn-ghost:hover { border-color: var(--fg); color: var(--fg); }
  .intro-toc { display: flex; flex-wrap: wrap; gap: .4rem 2rem; list-style: none; padding: 1rem 0 0; margin: 0; max-width: none; border-top: 1px solid rgba(243,238,228,.15); }
  .intro-toc li { margin: 0; }
  .intro-toc a { color: var(--fg); text-decoration: none; font-size: .95rem; }
  .intro-toc a:hover { color: var(--accent); }
  .intro-toc span { color: var(--accent); font-variant-numeric: tabular-nums; margin-right: .5rem; font-size: .8rem; }

  @keyframes intro-in { from { opacity: 0; translate: 0 16px; } }

  /* Phones and reduced motion: no scroll trick, just a static dark hero */
  @media (max-width: 760px), (prefers-reduced-motion: reduce) {
    .intro { height: auto; --p: 1; }
    .intro-stage { position: relative; height: auto; min-height: 88svh; display: flex; align-items: flex-end; }
    .intro-panels { inset: 0; }
    .ip-brand { display: none; }
    .ip-side { display: none; }
    .intro-copy { position: relative; opacity: 1; translate: none; padding-top: 30svh; animation: fade-up .8s ease-out both; }
    .intro-toc { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .intro-copy { animation: none; } }
  @keyframes fade-up { from { opacity: 0; translate: 0 24px; } }
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-intro]');
  const mq = matchMedia('(max-width: 760px), (prefers-reduced-motion: reduce)');
  if (el) {
    let target = 0, current = 0, raf = 0;
    const ease = (t: number) => t * t * (3 - 2 * t);   // smoothstep
    const measure = () => {
      const r = el.getBoundingClientRect();
      const run = el.offsetHeight - innerHeight;
      target = Math.min(1, Math.max(0, -r.top / (run * 0.75)));
    };
    const tick = () => {
      current += (target - current) * 0.14;             // ease toward the scroll position
      if (Math.abs(target - current) < 0.0005) current = target;
      el.style.setProperty('--p', ease(current).toFixed(4));
      raf = current === target ? 0 : requestAnimationFrame(tick);
    };
    const onScroll = () => {
      measure();
      if (mq.matches) { el.style.removeProperty('--p'); return; }
      if (!raf) raf = requestAnimationFrame(tick);
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    mq.addEventListener('change', onScroll);
    measure(); current = target; onScroll();
  }
</script>
