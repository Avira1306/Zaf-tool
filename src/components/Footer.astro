---
import Logo from './Logo.astro';
import { SITE, features, comparisons, templates } from '../data/site';
---
<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <Logo />
        <p style="margin-top:.8rem;max-width:34ch">AI financial due diligence inside Excel. Built by FDD practitioners for deal teams.</p>
        <p class="small">{SITE.company}<br/>Gurugram, India · Serving deal teams in the US, UK, EU, Nordics and India</p>
      </div>
      <div><h4>Product</h4><ul>
        {features.slice(0,7).map(f => <li><a href={`/features/${f.slug}`}>{f.name}</a></li>)}
        <li><a href="/features">All features</a></li>
      </ul></div>
      <div><h4>Compare</h4><ul>
        {comparisons.map(c => <li><a href={`/compare/${c.slug}`}>vs {c.competitor}</a></li>)}
        <li><a href="/compare/macabacus-alternative">Macabacus alternative</a></li>
      </ul></div>
      <div><h4>FDD templates</h4><ul>
        {templates.map(t => <li><a href={`/fdd-templates/${t.slug}`}>{t.name}</a></li>)}
      </ul></div>
      <div><h4>Company</h4><ul>
        <li><a href="/pricing">Pricing</a></li>
        <li><a href="/start-trial">Free trial</a></li>
        <li><a href="/hours-saved">Hours saved calculator</a></li>
        <li><a href="/fdd-templates">Template library</a></li>
        <li><a href="/security">Security</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/changelog">Changelog</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href={`mailto:${SITE.supportEmail}`}>Support</a></li>
        <li><a href={SITE.linkedin} rel="noopener">LinkedIn</a></li>
      </ul></div>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {SITE.company}. All rights reserved.</span>
      <span>Excel is a trademark of Microsoft Corporation. Competitor names are trademarks of their respective owners.</span>
    </div>
  </div>
</footer>
