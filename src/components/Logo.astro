  <svg viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="4" fill={dark ? '#ffffff' : '#1b2a4a'} />
    <path d="M8 9h16v3.2L14.2 20.8H24V23H8v-3.2l9.8-8.6H8z" fill={dark ? '#1b2a4a' : '#ffffff'} />
    <rect x="8" y="24.5" width="16" height="1.6" fill="#c9a84c" />
  </svg>
  <span style={dark ? 'color:#fff' : ''}>ZAF Tools</span>
</a>
