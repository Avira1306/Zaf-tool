---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  type?: 'website' | 'article';
  image?: string;
  jsonld?: object | object[];
  noindex?: boolean;
  crumbs?: { name: string; href: string }[];
}
const { title, description, type = 'website', image = '/img/og-default.png', jsonld, noindex = false, crumbs } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '');
const canonical = Astro.props.canonical ?? (SITE.url + path);
const ogImage = new URL(image, SITE.url).href;

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/icon-512.png`,
  email: SITE.email,
  founder: { '@type': 'Person', name: SITE.founder, sameAs: SITE.linkedin },
  legalName: SITE.legalEntity,
  address: { '@type': 'PostalAddress', addressLocality: 'Gurugram', addressCountry: 'IN' },
  sameAs: [SITE.linkedin],
};
const software = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ZAF Tools',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'Financial due diligence',
  operatingSystem: 'Windows, Microsoft Excel 2016-365',
  softwareVersion: SITE.version,
  url: SITE.url,
  description: SITE.description,
  offers: [
    { '@type': 'Offer', name: 'Solo', price: '29', priceCurrency: 'USD', billingIncrement: 'P1M', url: `${SITE.url}/pricing` },
    { '@type': 'Offer', name: 'Pro', price: '189', priceCurrency: 'USD', billingIncrement: 'P1M', url: `${SITE.url}/pricing` },
  ],
  publisher: { '@type': 'Organization', name: SITE.company },
};
const breadcrumb = crumbs
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Home', href: '/' }, ...crumbs].map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: new URL(c.href, SITE.url).href,
      })),
    }
  : null;
const extra = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="ZAF Tools" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <meta name="theme-color" content="#fbfaf7" />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    <script type="application/ld+json" set:html={JSON.stringify(software)} />
    {breadcrumb && <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />}
    {extra.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <Nav />
    <main id="main">
      {crumbs && (
        <div class="wrap crumbs" style="margin-top:1rem">
          <a href="/">Home</a>
          {crumbs.map((c, i) => (
            <>
              {' / '}
              {i === crumbs.length - 1 ? <span>{c.name}</span> : <a href={c.href}>{c.name}</a>}
            </>
          ))}
        </div>
      )}
      <slot />
    </main>
    <Footer />
    <script>
      // Smooth reveal: sections, then their cards/rows one after another. Content is visible without JS.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => es.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('in'); io.unobserve(e.target);
        }), { rootMargin: '0px 0px -8% 0px' });
        const below = (el: Element) => el.getBoundingClientRect().top > innerHeight * 0.95;
        document.querySelectorAll<HTMLElement>('main > section:not([data-intro]) > .wrap > :is(h2, .eyebrow, .lede, .grid-2, figure, .shot)').forEach((el) => {
          if (below(el)) { el.classList.add('reveal'); io.observe(el); }
        });
        const groups = '.cards > *, .stats > *, .flow > li, .tiers > *, .engines > *, .quotes > *, .rows > .row, .post-list > li, .faq > details';
        document.querySelectorAll<HTMLElement>(groups).forEach((el) => {
          if (!below(el)) return;
          const i = Array.from(el.parentElement!.children).indexOf(el);
          el.style.setProperty('--d', `${Math.min(i, 6) * 70}ms`);
          el.classList.add('reveal'); io.observe(el);
        });
        // Count up the headline stats (80%, 150+, 7)
        document.querySelectorAll<HTMLElement>('.stats strong, .ps-stat strong').forEach((s) => {
          const m = s.textContent!.match(/^(\d+)(.*)$/); if (!m || +m[1] < 2) return;
          const end = +m[1], suf = m[2];
          const o = new IntersectionObserver(([e]) => {
            if (!e.isIntersecting) return; o.disconnect();
            const t0 = performance.now();
            const step = (t: number) => {
              const k = Math.min(1, (t - t0) / 1100);
              s.textContent = Math.round(end * (1 - Math.pow(1 - k, 3))) + suf;
              if (k < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          }, { threshold: .6 });
          o.observe(s);
        });
      }
    </script>
  </body>
</html>
